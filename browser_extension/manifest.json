{
  "manifest_version": 3,
  "name": "MindGuard AI - Digital Wellness & Active Browsing Monitor",
  "version": "1.0.0",
  "description": "Authentic domain-level screen time, active tab duration, and consent-based search analytics for MindGuard AI.",
  "permissions": [
    "tabs",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:42424/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MindGuard Digital Wellness Monitor"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
